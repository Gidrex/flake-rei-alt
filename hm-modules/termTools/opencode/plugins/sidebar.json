{
  "items": [
    {
      "type": "custom",
      "command": "basename \"$(pwd)\"",
      "format": " {output}"
    },
    {
      "type": "git-branch",
      "format": " {branch}"
    },
    {
      "type": "git-diff",
      "format": " +{added} ~{deleted}"
    }
  ],
  "refreshInterval": 500,
  "periodicInterval": 3000
}
