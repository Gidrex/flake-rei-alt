{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-macchiato"
  },
  "plugins": [
    "-internal:sidebar-context"
  ],
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "permissions": "prompt"
  },
  "animations": true,
  "keybinds": {
    "app.exit": "ctrl+c,ctrl+d",
    "session.queued_prompts": "ctrl+q",
    "opencode.status": "ctrl+s",
    "session.new": "ctrl+n",
    "session.list": "ctrl+l",
    "messages.copy": "ctrl+y"
  },
  "tabs": {
    "mode": "off",
    "layout": "horizontal",
    "indicators": "status",
    "scope": "cwd"
  }
}
