// All windows settings
window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
    draw-border-with-background false
}

// Steam never steals focus
window-rule {
    match app-id=r#"(?i)steam"#
    match app-id=r#"^steam_app_"#
    open-focused false
}

// Enable VRR
window-rule {
    variable-refresh-rate true
    // match app-id="^mpv$"
    match app-id=r#"^steam_app_"#
    match app-id=r#"(?i)Minecraft"#
}

// No borders
window-rule {
    match app-id=".*zen"
    match app-id="Yandex-browser"
    match app-id="glide-glide"
    match app-id="chromium"
    match app-id=r#"(?i)minecraft"#
    match app-id=r#"^steam_app_"#
    match app-id="foot"
    match app-id="kitty"
    match app-id="Antigravity"
    match app-id="chromiumon-demand"
    match app-id="chrome-.*"
    match app-id="ONLYOFFICE"
    match app-id=r#".*libreoffice.*"#
    match app-id="clash-verge"
    match app-id="TablePlus"
    match app-id="Hermes"
    match app-id="com.nousresearch.hermes"
    draw-border-with-background false
    border {
        width 0
    }
    focus-ring {
        width 0
    }
}

window-rule {
    match title="Glow Preview"
    open-floating true
    default-window-height { proportion 1.0; }
}

// Notes: foot --title notes opens as a floating window on the current
// workspace, hidden from screencasts.
// Height 0.993 ~= 4px top/bottom margins (icelake 960 logical px -> ~3.4px,
// tigerlake 1440 -> ~5px). Exact px margins are impossible for floating
// windows in niri (no calc(); gaps apply to tiling only).
window-rule {
    match title="^notes$"
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.92; }
    block-out-from "screencast"
}

// 1.0 proportion
window-rule {
    match app-id=".*zen"
    match app-id="Antigravity"
    match title="Minecraft*"
    match app-id=r#"^steam_app_"#
    match app-id="TablePlus"
    match app-id="glide-glide"
    match app-id="Hermes"
    match app-id="com.nousresearch.hermes"
    default-column-width { proportion 1.0; }
}

// Hidden from screencast
window-rule {
    block-out-from "screencast"
    match app-id=r#".*ayugram.*"#
    match app-id=r#".*telegram.*"#
    match title=r#"(?i)bitwarden"#
}
layer-rule {
    block-out-from "screencast"
    match namespace="^notifications$"
}
layer-rule {
    block-out-from "screencast"
    match namespace="^noctalia-notification$"
}

window-rule {
    match title=r#"Extension.*Aria2.*Download Panel"#
    default-column-width { proportion 0.25; }
    open-floating false
}

// Per workspace config
window-rule {
    match app-id=".*zen"
    match app-id="glide-glide"
    match app-id="Yandex-browser"
    match app-id="chromium"
    open-on-workspace "1"
}

window-rule {
    match app-id=r#"(?i)steam"#
    match app-id=r#"(?i)prismlauncher"#
    match app-id=r#"(?i)minecraft"#
    match app-id=r#"(?i)HytaleClient"#
    match app-id="Antigravity"
    open-on-workspace "3"
}

window-rule {
    match app-id="Hermes"
    match app-id="com.nousresearch.hermes"
    open-on-workspace "4"
}

window-rule {
    match app-id="goofcord"
    match app-id="equibop"
    match app-id=r#".*telegram.*"#
    match app-id=r#".*ayugram.*"#
    open-on-workspace "5"
}

window-rule {
    match app-id="com.github.wwmm.easyeffects"
    match app-id="Vial"
    match app-id="blueberry.py"
    match app-id="org.pulseaudio.pavucontrol"
    match app-id="Emulator"
    open-on-workspace "6"
}
