layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

window-rule {
    open-on-output "DP-2"
    match app-id=r#".*ayugram.*"#
    match app-id=r#".*telegram.*"#
    match app-id="blueberry.py"
    match app-id="MAX"
    default-column-width { proportion 0.25; }
}

window-rule {
    open-on-output "DP-2"
    match app-id=r#".*prismlauncher.*"#
    match app-id="goofcord"
    match app-id="equibop"
    default-column-width { proportion 0.5; }
}

window-rule {
    open-on-output "DP-2"
    match app-id=r#"(?i)steam"#
    match app-id="foot"
    match app-id="kitty"
    match app-id="ONLYOFFICE"
    match app-id="clash-verge"
    match app-id="^mpv$"
    match app-id="chrome-.*"
    match app-id="chromium"
    match app-id="com.follow.clash"
    default-column-width { proportion 0.75; }
}

window-rule {
    open-on-output "DP-2"
    match app-id="Tabletop Simulator.x86_64"
    open-fullscreen true
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id="glide-glide" title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    open-on-workspace "mini"
    match app-id="foot-mini"
    match app-id="kitty-mini"
    // match app-id="mpv"
    default-column-width { proportion 1.0; }
    open-fullscreen true
    draw-border-with-background false
    geometry-corner-radius 0
    clip-to-geometry true
    focus-ring {
        off
    }
    border {
        off
    }
    shadow {
        off
    }
}

window-rule {
    match app-id="foot" is-active=true
    opacity 0.97
}

window-rule {
    match app-id="foot" is-active=false
    opacity 0.8
}

