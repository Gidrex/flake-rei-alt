layout {
    default-column-width { proportion 0.5; }
    gaps 3
}

workspace "1" { open-on-output "DP-2"; }
workspace "2" { open-on-output "DP-2"; }
workspace "3" { open-on-output "DP-2"; }
workspace "4" { open-on-output "DP-2"; }
workspace "5" { open-on-output "DP-2"; }
workspace "6" { open-on-output "DP-2"; }
workspace "7" { open-on-output "DP-2"; }
workspace "8" { open-on-output "DP-2"; }
workspace "9" { open-on-output "DP-2"; }

workspace "mini" {
    open-on-output "HDMI-A-1"
    layout {
        gaps 0
        focus-ring {
            off
        }
        border {
            off
        }
        shadow {
            off
        }
    }
}
